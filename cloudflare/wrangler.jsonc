{
  "name": "headline-private-gateway",
  "main": "worker.mjs",
  "account_id": "8880c572ebb4dc754a21561b44c02b97",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  // Enable the API route only AFTER configuring Google login and Cloudflare DNS proxy.
  "routes": [{"pattern": "headline.infinitas.top/api/cloud/*", "zone_name": "infinitas.top"}],
  "vars": {
    "PUBLIC_HOST": "headline.infinitas.top",
    "GOOGLE_CLIENT_ID": "1014462720833-b7079ftdpfcu38ptaaj9htlmqq1roe7r.apps.googleusercontent.com",
    "FREE_TIER_CONFIRMED": "false",
    "DAILY_REQUEST_LIMIT": "100"
  },
  "ratelimits": [
    {"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}},
    {"name": "LOGIN_RATE_LIMITER", "namespace_id": "1002", "simple": {"limit": 5, "period": 60}}
  ],
  "d1_databases": [{"binding":"BUDGET","database_name":"headline-budget","database_id":"f2bf70e0-03ef-4a33-b5e0-45fe125e6baa"}]
  // GEMINI_API_KEY, SESSION_SECRET and ALLOWED_EMAIL must be entered as Worker Secrets, never committed.
}
