{
  "name": "headline-private-gateway",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-18",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {"enabled": false},
  // Enable the API route only AFTER configuring Access and Cloudflare DNS proxy.
  // "routes": [{"pattern": "headline.infinitas.top/api/cloud/*", "zone_name": "infinitas.top"}],
  "vars": {
    "PUBLIC_HOST": "headline.infinitas.top",
    "ACCESS_ISSUER": "",
    "ACCESS_AUD": "",
    "FREE_TIER_CONFIRMED": "false",
    "DAILY_REQUEST_LIMIT": "100"
  },
  "ratelimits": [{"name": "RATE_LIMITER", "namespace_id": "1001", "simple": {"limit": 10, "period": 60}}]
  // Add BUDGET D1 binding with its real database ID after creating the database.
  // GEMINI_API_KEY and ALLOWED_EMAIL must be entered as Worker Secrets, never committed.
}
